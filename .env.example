# ── Server (copy to server/.env) ───────────────────────────────────────────────
PORT=5000
JWT_SECRET=change_me_in_production_use_a_long_random_string
DB_PATH=./database.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# In production (Render): set CLIENT_URL to your Vercel URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ── Client (copy to client/.env) ───────────────────────────────────────────────
# Leave empty in dev (Vite proxy handles /api → localhost:5000)
# In production (Vercel): set to your Render backend URL, e.g. https://your-api.onrender.com
VITE_API_URL=
